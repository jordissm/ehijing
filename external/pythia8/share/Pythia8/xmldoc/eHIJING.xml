<chapter name="eHIJING">
<word name="eHIJING:SeedContext" default="0">
Unsigned 64-bit chunk context supplied by ELECTRA's versioned seed policy.
</word>
<mode name="eHIJING:SeedRole" default="0" min="0" max="1">
Stream namespace: 0 for the hard generator, 1 for the separate hadronizer.
</mode>
<flag name="eHIJING:ExplicitNucleus" default="off"></flag>
<parm name="eHIJING:NucleonWidth" default="0.5" min="0.000001"></parm>
<parm name="eHIJING:NuclearRadius" default="0.0" min="0.0"></parm>
<parm name="eHIJING:NuclearSurface" default="0.0" min="0.0"></parm>
<parm name="eHIJING:HulthenAlpha" default="0.228" min="0.000001"></parm>
<parm name="eHIJING:HulthenBeta" default="1.18" min="0.000001"></parm>

<flag name="eHIJING:all" default="off"> 
<option value="off"> Turn off medium-induced emission in eHIJING </option> 
<option value="on"> Turn on medium-induced emission in eHIJING </option> 
</flag> 

<parm name="eHIJING:MediumModificationSplittingFunctionMode" default="0" min="0" max="1"> 
</parm> 
 
<parm name="eHIJING:MassNumber" default="208" min="1">
</parm> 

<parm name="eHIJING:AtomicNumber" default="82" min="0">
</parm> 

<parm name="eHIJING:TransverseMomentumDistributionConstant" default="1.0" min="0.0"> 
</parm> 

<parm name="eHIJING:xG-n" default="4.0" min="0.0" max="10.0"> 
</parm> 

<parm name="eHIJING:xG-lambda" default="-0.2" min="-0.5" max="0.0"> 
</parm> 

<word name="eHIJING:TabulationPath" default="./eHIJING-Tables/"> 
</word> 
 
</chapter> 
 

